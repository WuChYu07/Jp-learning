# ── Secrets（絕對不要 commit／push）──────────────────────────────────────────
# 真實金鑰放 backend/.env、frontend/.env；只允許提交 *.env.example 範本
.env
.env.*
!.env.example
!**/.env.example
**/credentials.json
**/service-account*.json
*.pem
recovery-codes.txt

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.cursor/
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.sw?

# ── Heavy / regenerable local data (keep on disk, do not push) ────────────────
data/*.pdf
data/extracted/
data/reports/

# ── Private interview / career notes (local only) ─────────────────────────────
docs/private/

# ── One-off local data-pipeline scratch (JLPT gap-fill run, not for push) ─────
backend/scripts/_cursor_fills.json
backend/scripts/_gaps.json
backend/scripts/_sql_batches/
