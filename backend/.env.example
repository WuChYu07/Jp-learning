# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Komorebi Japanese API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated origins for CORS (frontend dev server, production domain)
# Production example after Vercel deploy:
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) from Dashboard → Settings → API Keys
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Secret key (sb_secret_...) — NEVER expose to frontend; backend only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# ── Gemini (你的 API Key — 從 https://aistudio.google.com/apikey 取得) ─────
# 免費方案建議: gemini-2.5-flash 或 gemini-2.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key
# Optional backups (comma-separated). On 429/quota, backend auto-switches.
# Example: GEMINI_API_KEYS=backup-key-2,backup-key-3
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Embedding model for semantic same_meaning links (768-dim)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_SIMILARITY_THRESHOLD=0.90
EMBEDDING_MATCH_TOP_K=5
EMBEDDING_MAX_SCORE_GAP=0.025

# ── Rate limiting (Module 4) ───────────────────────────────────────────────────
DAILY_AI_REQUEST_LIMIT=50

# ── SRS defaults (Module 1) ──────────────────────────────────────────────────
SRS_DEFAULT_EASINESS_FACTOR=2.5
SRS_DEFAULT_INTERVAL_DAYS=1

# Set false only if local Windows SSL verification fails (development only)
SSL_VERIFY=true

# ── Auth (single-user: no login required) ────────────────────────────────────
# Set true only when enabling multi-user Supabase login
AUTH_ENABLED=false
# Optional override. Leave empty — solo mode uses a fixed built-in owner id.
# DEV_USER_ID=

# ── Notion (optional — Notion sync / probe scripts) ───────────────────────────
# 1. Create integration: https://www.notion.so/my-integrations
# 2. Open your grammar notes page → ... → Connections → add the integration
# 3. Copy page ID from browser URL (last 32 hex chars), e.g.:
#    https://www.notion.so/My-Notes-a1b2c3d4e5f6...  →  a1b2c3d4e5f6...
#    Or pass full URL to: python scripts/test_notion_fetch.py --page-url "..."
# 3. Copy page IDs from browser URLs (last 32 hex chars each):
#    NOTION_VOCAB_PAGE_ID=...    (vocabulary notes)
#    NOTION_GRAMMAR_PAGE_ID=...  (grammar notes)
# Legacy: NOTION_PAGE_ID still works if you only have one page
NOTION_TOKEN=
NOTION_VOCAB_PAGE_ID=
NOTION_GRAMMAR_PAGE_ID=
NOTION_PAGE_ID=
# Skip manual review after sync (default false = preview first)
NOTION_AUTO_APPROVE=false
NOTION_STORAGE_BUCKET=notion-images
